# KAIRO Frontend Environment Configuration Template
# Copy this file to .env.local: cp .env.example .env.local

# Backend API Endpoint (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pipeline Mode: 'true' uses simulated pipeline & mock history, 'false' calls backend API
NEXT_PUBLIC_USE_MOCK=true

# Supabase Configuration (Authentication & Database)
# Found under: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
